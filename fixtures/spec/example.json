{
  "version": 1,
  "name": "Example analytics",
  "theme": { "preset": "Constellation", "canvas": { "width": 1400, "height": 1000 } },
  "data_sources": [
    { "name": "Metrics", "project_id": "example-project", "dataset_id": "example_data", "table_id": "traffic data" },
    { "name": "One", "project_id": "example-project", "sql": "SELECT 'a' AS category, 1 AS value" }
  ],
  "parameters": [
    { "data_source": "Metrics", "name": "Target", "id": "target", "data_type": "Number (whole)", "default_value": 3 }
  ],
  "calculated_fields": [
    { "data_source": "Metrics", "name": "Adjusted", "formula": "value * target" }
  ],
  "group_fields": [
    { "data_source": "Metrics", "name": "Segments", "field": "category", "groups": [{ "name": "Selected", "values": ["a"] }], "other_group": "Remaining" }
  ],
  "bin_fields": [
    { "data_source": "Metrics", "name": "Value bands", "field": "value", "size": 5, "min": 0, "max": 50 }
  ],
  "blends": [
    {
      "name": "Joined",
      "tables": [
        { "data_source": "Metrics", "dimensions": ["category"], "metrics": ["value"] },
        { "data_source": "One", "dimensions": ["category"], "metrics": ["value"] }
      ],
      "joins": [{ "type": "left outer", "keys": [["category", "category"]] }]
    }
  ],
  "pages": [
    {
      "name": "Overview",
      "components": [
        { "component": "text", "text": "Example", "font_size": 28, "bold": true, "position": { "left": 40, "top": 20, "width": 600, "height": 50 } },
        { "component": "chart", "type": "table", "data_source": "Joined", "dimensions": ["category"], "metrics": [{ "field": "value", "aggregation": "sum" }], "position": { "left": 40, "top": 100, "width": 600, "height": 320 } },
        { "component": "control", "kind": "button", "button": { "action": "link", "page": "Details", "new_tab": false }, "position": { "left": 700, "top": 20, "width": 200, "height": 40 } }
      ]
    },
    {
      "name": "Details",
      "components": [
        { "component": "shape", "shape": "star", "background": "#FF8F00", "position": { "left": 40, "top": 40, "width": 200, "height": 200 } }
      ],
      "settings": { "data_source": "Metrics", "date_range_dimension": "day", "date_range": "Last 28 days", "style": { "Page background": "#FAFAFA" } }
    }
  ],
  "report_components": [
    { "component": "text", "text": "Every page", "position": { "left": 40, "top": 900, "width": 300, "height": 40 } }
  ],
  "report_settings": { "data_source": "Metrics" }
}
